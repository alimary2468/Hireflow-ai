{
  "name": "hireflow-ai",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Candidate Screening Agent for HR Departments",
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npx -p typescript tsc -p server/tsconfig.json",
    "build:client": "npm run build --prefix client",
    "build": "prisma generate && prisma db push && tsx server/src/db/seed.ts && npm run build:server && npm run build:client",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx server/src/db/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "mammoth": "^1.7.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.11",
    "openai": "^4.28.0",
    "pdf-parse": "^1.1.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.24",
    "@types/nodemailer": "^6.4.14",
    "@types/pdf-parse": "^1.1.4",
    "concurrently": "^8.2.2",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
