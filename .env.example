# Environment Variables Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Prisma SQLite by default, configurable to Postgres)
DATABASE_URL="file:./dev.db"

# LLM Configuration (Set either or both; smart fallback mode activates if empty)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Clerk Authentication (Set keys for production Clerk auth, fallback guest mode works if empty)
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Email Notification Configuration (Resend or SMTP; log simulation works if empty)
EMAIL_API_KEY=
EMAIL_FROM="HireFlow AI <recruitment@hireflow.ai>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional Slack Integration Webhook
SLACK_WEBHOOK_URL=
